<?xml version="1.0" encoding="UTF-8"?>
<config>


    <!-- 5G cellular network -->
    <interface hosts="gnb[*]" names="cellular" address="10.0.x.x" netmask="255.0.0.0" />

    <!-- Server network (10.5.x.x) - wired nodes connect to router -->
    <interface hosts="serverGateway" names="eth*" address="10.5.0.2" netmask="255.255.0.0" />
    <interface hosts="wired[*]" names="eth*" address="10.5.x.x" netmask="255.255.0.0" />


    <!-- Default -->
    <interface hosts="*" address="192.168.x.x" netmask="255.255.255.0" />

    <!-- Routing -->
    <!-- Default gateway for wired nodes -->
    <route hosts="wired[*]" destination="*" gateway="serverGateway" />

    <!-- Route cellular traffic from serverGateway to UPF -->
    <route hosts="serverGateway" destination="10.2.0.0" netmask="255.0.0.0" gateway="192.168.0.2" />
    <!-- Return route: UPF knows how to reach wired network -->
    <route hosts="upf" destination="10.5.0.0" netmask="255.255.0.0" gateway="192.168.0.1" />
    <!-- gNodeB knows how to reach wired network -->
    <route hosts="gnb[*]" destination="10.5.0.0" netmask="255.255.0.0" gateway="upf" />

</config>